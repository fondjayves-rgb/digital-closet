PORT=3001
WEB_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Worker only. Use a Supabase secret key; a legacy service_role key is also supported.
# Never prefix this with VITE_ or put it in apps/web/.env.
SUPABASE_SECRET_KEY=your-server-secret-key
OPENAI_API_KEY=your-openai-api-key
# Set a model available to your account that supports images, Responses, and structured outputs.
OPENAI_MODEL=
