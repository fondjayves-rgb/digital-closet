{
  "name": "loopwear-wardrobe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"npm run dev -w @wardrobe/api\" \"npm run dev -w @wardrobe/web\"",
    "worker": "npm run worker -w @wardrobe/api",
    "build": "npm run build -w @wardrobe/shared && npm run build -w @wardrobe/api && npm run build -w @wardrobe/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "test": "vitest run",
    "test:live": "tsx --env-file-if-exists=apps/api/.env tests/live.ts",
    "test:browser": "playwright test",
    "db:cli": "supabase"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@playwright/test": "^1.64.1",
    "@types/supertest": "^6.0.3",
    "concurrently": "^9.2.1",
    "supabase": "2.121.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  }
}
